{
  "name": "toolbox",
  "version": "0.2.0",
  "private": true,
  "description": "Node-graph motion design tool",
  "author": "The Collected Works",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron electron/main.js",
    "electron:dev": "TOOLBOX_DEV_URL=http://localhost:3000 electron electron/main.js",
    "dev:desktop": "node scripts/electron-dev.mjs",
    "electron:build": "electron-builder --mac",
    "electron:build:win": "electron-builder --win",
    "desktop:prepare": "node scripts/prepare-standalone.mjs",
    "desktop:build": "npm run desktop:prepare && electron-builder --mac",
    "desktop:build:win": "npm run desktop:prepare && electron-builder --win",
    "desktop:publish": "npm run desktop:prepare && electron-builder --mac -p always",
    "desktop:publish:win": "npm run desktop:prepare && electron-builder --win -p always",
    "build:export-template": "node scripts/build-export-template.mjs",
    "install:export-template": "npm --prefix src/export-template install"
  },
  "build": {
    "appId": "com.thecollectedworks.toolbox",
    "productName": "Toolbox",
    "publish": {
      "provider": "github",
      "owner": "henrysallan",
      "repo": "toolbox",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "src/lib/export-ffmpeg-args.js",
      "package.json",
      "!node_modules/**/*",
      "node_modules/ffmpeg-static/**/*",
      ".next/standalone/**/*",
      ".next/standalone/.next/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      ".next/standalone/**/*",
      ".next/standalone/.next/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@types/three": "^0.184.0",
    "@xyflow/react": "^12.10.2",
    "atrament": "^5.1.0",
    "bezier-js": "^6.1.4",
    "d3-delaunay": "^6.0.4",
    "ffmpeg-static": "^5.3.0",
    "gifsicle-wasm-browser": "^1.5.19",
    "jszip": "^3.10.1",
    "mediabunny": "^1.41.0",
    "next": "16.2.4",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bezier-js": "^4.1.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.69",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
