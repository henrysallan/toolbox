{
  // Main thread: the Figma sandbox (no DOM). Type-checked from the repo root:
  // npm run figma-plugin:typecheck
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "typeRoots": ["../node_modules/@types", "../node_modules/@figma"],
    "types": ["plugin-typings"]
  },
  "files": ["src/code.ts", "src/globals.d.ts"]
}
