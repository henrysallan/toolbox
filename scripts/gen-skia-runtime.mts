// Bundles src/lib/skia-export/runtime/toolbox-timeline.ts (the worklet
// keyframe evaluator every React Native Skia export ships verbatim) into a
// string module, so the editor's export action and the MCP export tools can
// emit it without reading files (specdocs/101326_skia-target.md §3.7). The
// CLI (scripts/export-skia.mts) keeps reading the .ts from disk.
//
//   npx tsx scripts/gen-skia-runtime.mts           write runtime.generated.ts
//   npx tsx scripts/gen-skia-runtime.mts --check   exit 1 when it is stale

import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";

const SRC = resolve(import.meta.dirname, "../src/lib/skia-export/runtime/toolbox-timeline.ts");
const OUT = resolve(import.meta.dirname, "../src/lib/skia-export/runtime.generated.ts");

const source = readFileSync(SRC, "utf8");
const ts = [
  "// GENERATED by scripts/gen-skia-runtime.mts from src/lib/skia-export/runtime/toolbox-timeline.ts.",
  "// Do not edit — edit the runtime and run `npm run gen:skia-runtime`.",
  "",
  "// The runtime's source text, exactly as it ships in every export bundle.",
  `export const TOOLBOX_TIMELINE_SOURCE = ${JSON.stringify(source)};`,
  "",
].join("\n");

if (process.argv.includes("--check")) {
  let onDisk = "";
  try {
    onDisk = readFileSync(OUT, "utf8");
  } catch {
    // missing ⇒ stale
  }
  if (onDisk !== ts) {
    console.error("runtime.generated.ts is stale — run `npm run gen:skia-runtime` and commit.");
    process.exit(1);
  }
  console.log(`runtime.generated.ts up to date (${source.length} chars).`);
} else {
  writeFileSync(OUT, ts);
  console.log(`Wrote ${OUT} (${source.length} chars)`);
}
