// After Effects half of the calibration runs (spec 091926_after-effects-handoff.md §14).
//
// runAeJob() runs one ExtendScript job inside aerender's render core through
// a one-launch user Startup hook (calibrate/hook.jsx, env-gated on
// TBX_AE_CALIBRATE_DRIVER and always removed), the route §13 measured. The
// job builds into the startup project, queues frames and saves the project;
// renderQueue() then renders that queue with a plain `aerender -project`
// (no hook). The owner's After Effects GUI is never contacted: aerender
// launches its own aerendercore.
//
// Needs After Effects 26.x at AE_DIR and "Allow Scripts to Write Files and
// Access Network" on (the jobs write JSON).

import { spawn } from "node:child_process";
import { copyFileSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { inflateSync } from "node:zlib";
import sharp from "sharp";

export const HERE = dirname(fileURLToPath(import.meta.url));
export const REPO = resolve(HERE, "../../..");
const AE_DIR = process.env.AE_DIR ?? "/Applications/Adobe After Effects 2026";
const AERENDER = join(AE_DIR, "aerender");
const PREFS_VERSION = process.env.AE_PREFS_VERSION ?? "26.5";
const STARTUP = join(homedir(), "Library/Preferences/Adobe/After Effects", PREFS_VERSION, "Scripts/Startup");
const HOOK = join(STARTUP, "zz_toolbox_ae_calibrate_hook.jsx");

const js = (v: unknown) => JSON.stringify(v).replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");

function removeHook() {
  if (existsSync(HOOK)) rmSync(HOOK);
}
process.on("exit", removeHook);
process.on("SIGINT", () => {
  removeHook();
  process.exit(130);
});

function aerender(env: Record<string, string>, args: string[], log: string, timeoutMs: number): Promise<number> {
  return new Promise((res) => {
    const child = spawn(AERENDER, args, { env: { ...process.env, ...env }, stdio: ["ignore", "pipe", "pipe"] });
    const chunks: Buffer[] = [];
    child.stdout.on("data", (d) => chunks.push(d));
    child.stderr.on("data", (d) => chunks.push(d));
    const timer = setTimeout(() => {
      chunks.push(Buffer.from(`\n[calibrate] timeout after ${timeoutMs} ms — killing aerender ${child.pid}\n`));
      child.kill("SIGKILL");
    }, timeoutMs);
    child.on("close", (code) => {
      clearTimeout(timer);
      writeFileSync(log, Buffer.concat(chunks));
      res(code ?? -1);
    });
  });
}

export interface AeJobResult {
  out: any; // eslint-disable-line @typescript-eslint/no-explicit-any
  seconds: number;
  code: number;
  log: string;
}

// Runs `job` (a file under calibrate/) with `cfg` as $.global.TBX_CAL; the
// job's CAL.out lands in <work>/<name>.json. `project`, when the job saves
// one, is what aerender is pointed at (a missing file only makes aerender
// complain after the job ran).
export async function runAeJob(name: string, job: string, cfg: Record<string, unknown>, work: string, timeoutMs = 600_000): Promise<AeJobResult> {
  if (!existsSync(AERENDER)) throw new Error(`aerender not found at ${AERENDER} (set AE_DIR)`);
  mkdirSync(work, { recursive: true });
  const outPath = join(work, `${name}.json`);
  rmSync(outPath, { force: true });
  rmSync(join(work, "hook-error.txt"), { force: true });
  const project = (cfg.project as string | undefined) ?? join(work, `${name}-none.aep`);
  const driver = join(work, `${name}-driver.jsx`);
  writeFileSync(
    driver,
    [
      "// Generated by scripts/ae-export-spike/calibrate/ae.mts.",
      "app.setSavePreferencesOnQuit(false);",
      `$.global.TBX_CAL = ${js({ ...cfg, out: outPath, work })};`,
      `$.evalFile(new File(${js(join(HERE, "lib.jsx"))}));`,
      "try {",
      `  $.evalFile(new File(${js(join(HERE, job))}));`,
      "} catch (e) {",
      "  CAL.out.errors.push('job: ' + e.toString() + (e.line ? ' (line ' + e.line + ')' : ''));",
      "}",
      "CAL.finish();",
      "",
    ].join("\n")
  );
  removeHook();
  mkdirSync(STARTUP, { recursive: true });
  copyFileSync(join(HERE, "hook.jsx"), HOOK);
  const t0 = Date.now();
  const log = join(work, `${name}-aerender.log`);
  let code: number;
  try {
    code = await aerender({ TBX_AE_CALIBRATE_DRIVER: driver }, ["-project", project, "-sound", "OFF"], log, timeoutMs);
  } finally {
    removeHook();
  }
  const seconds = (Date.now() - t0) / 1000;
  if (existsSync(join(work, "hook-error.txt"))) throw new Error(`hook error: ${readFileSync(join(work, "hook-error.txt"), "utf8")}`);
  if (!existsSync(outPath)) throw new Error(`job ${name} wrote no ${outPath} (aerender exit ${code}; log ${log})`);
  const out = JSON.parse(readFileSync(outPath, "utf8"));
  return { out, seconds, code, log };
}

// Renders a saved project's queue (no hook).
export async function renderQueue(project: string, work: string, timeoutMs = 1_200_000): Promise<{ code: number; seconds: number }> {
  const t0 = Date.now();
  const code = await aerender({}, ["-project", project, "-sound", "OFF"], join(work, `render-${Date.now()}.log`), timeoutMs);
  return { code, seconds: (Date.now() - t0) / 1000 };
}

// AE's queued output is <prefix>_[#####].tif|png; returns the first frame file.
export function renderedFile(dir: string, prefix: string): string | null {
  if (!existsSync(dir)) return null;
  const f = readdirSync(dir).find((x) => x.startsWith(`${prefix}_`) && /\.(tif|png)$/.test(x));
  return f ? join(dir, f) : null;
}

// A rendered frame as straight float RGBA: 16-bit PNGs are straight already,
// TIFFs are unpremultiplied.
export async function readAeFrame(path: string): Promise<FloatImage> {
  return path.endsWith(".png") ? readPng(path) : readAeTiff(path);
}

export interface FloatImage {
  width: number;
  height: number;
  // Straight-alpha RGBA, 0..1, row 0 = top.
  data: Float32Array;
  bits: 8 | 16;
}

// aerender's "TIFF Sequence with Alpha" is premultiplied (matted with black,
// spec §13); this unpremultiplies.
export async function readAeTiff(path: string): Promise<FloatImage> {
  const meta = await sharp(path).metadata();
  const bits = meta.depth === "ushort" ? 16 : 8;
  const { data, info } = await sharp(path)
    .ensureAlpha()
    .raw({ depth: bits === 16 ? "ushort" : "uchar" })
    .toBuffer({ resolveWithObject: true });
  const src = bits === 16 ? new Uint16Array(data.buffer, data.byteOffset, data.byteLength / 2) : new Uint8Array(data);
  const max = bits === 16 ? 65535 : 255;
  const n = info.width * info.height;
  const out = new Float32Array(n * 4);
  for (let i = 0; i < n; i++) {
    const a = src[i * info.channels + 3] / max;
    out[i * 4 + 3] = a;
    for (let c = 0; c < 3; c++) {
      const v = src[i * info.channels + c] / max;
      out[i * 4 + c] = a > 0 ? Math.min(1, v / a) : 0;
    }
  }
  return { width: info.width, height: info.height, data: out, bits };
}

// PNG reader for AE's "_HIDDEN X-Factor 16" template (PNG Sequence,
// Trillions of Colors+, STRAIGHT alpha — the only 16-bit output a script can
// pick: Depth is read-only on every output module). sharp narrows 16-bit
// PNGs to 8-bit values even with raw({ depth: "ushort" }), so this decodes
// them itself: 8/16-bit RGB(A), non-interlaced, all five filters.
export function readPng(path: string): FloatImage {
  const b = readFileSync(path);
  let o = 8;
  let w = 0;
  let h = 0;
  let bits = 8;
  let ctype = 6;
  const idat: Buffer[] = [];
  while (o < b.length) {
    const len = b.readUInt32BE(o);
    const t = b.toString("latin1", o + 4, o + 8);
    const d = b.subarray(o + 8, o + 8 + len);
    if (t === "IHDR") {
      w = d.readUInt32BE(0);
      h = d.readUInt32BE(4);
      bits = d[8];
      ctype = d[9];
      if (d[12] !== 0) throw new Error(`${path}: interlaced PNG`);
    } else if (t === "IDAT") idat.push(d);
    o += 12 + len;
  }
  const ch = ctype === 6 ? 4 : ctype === 2 ? 3 : 0;
  if (!ch || (bits !== 8 && bits !== 16)) throw new Error(`${path}: PNG color type ${ctype} / ${bits} bits not supported`);
  const bpp = (ch * bits) / 8;
  const stride = w * bpp;
  const raw = inflateSync(Buffer.concat(idat));
  const cur = Buffer.alloc(stride);
  const prev = Buffer.alloc(stride);
  const out = new Float32Array(w * h * 4);
  const max = bits === 16 ? 65535 : 255;
  for (let y = 0; y < h; y++) {
    const f = raw[y * (stride + 1)];
    const line = raw.subarray(y * (stride + 1) + 1, (y + 1) * (stride + 1));
    for (let i = 0; i < stride; i++) {
      const a = i >= bpp ? cur[i - bpp] : 0;
      const up = prev[i];
      const c = i >= bpp ? prev[i - bpp] : 0;
      let v = line[i];
      if (f === 1) v += a;
      else if (f === 2) v += up;
      else if (f === 3) v += (a + up) >> 1;
      else if (f === 4) {
        const p = a + up - c;
        const pa = Math.abs(p - a);
        const pb = Math.abs(p - up);
        const pc = Math.abs(p - c);
        v += pa <= pb && pa <= pc ? a : pb <= pc ? up : c;
      }
      cur[i] = v & 0xff;
    }
    for (let x = 0; x < w; x++)
      for (let k = 0; k < 4; k++) {
        const s = k < ch ? (bits === 16 ? cur.readUInt16BE((x * ch + k) * 2) : cur[x * ch + k]) : max;
        out[(y * w + x) * 4 + k] = s / max;
      }
    cur.copy(prev);
  }
  return { width: w, height: h, data: out, bits: bits as 8 | 16 };
}

export function toRgba8(img: { width: number; height: number; data: Float32Array }): Uint8ClampedArray {
  const out = new Uint8ClampedArray(img.width * img.height * 4);
  for (let i = 0; i < out.length; i++) out[i] = Math.round(img.data[i] * 255);
  return out;
}
