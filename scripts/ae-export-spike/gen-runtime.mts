// Bundles src/lib/ae-export/runtime/build.jsx into a string module so the
// package writer (web and desktop) can emit it without reading files — the
// same pattern as scripts/gen-skia-runtime.mts. The gate
// (scripts/ae-export/check-runtime.mts) fails when the module is stale.
//
//   npx tsx scripts/ae-export-spike/gen-runtime.mts           write build-jsx.generated.ts
//   npx tsx scripts/ae-export-spike/gen-runtime.mts --check   exit 1 when it is stale

import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";

const SRC = resolve(import.meta.dirname, "../../src/lib/ae-export/runtime/build.jsx");
const OUT = resolve(import.meta.dirname, "../../src/lib/ae-export/runtime/build-jsx.generated.ts");

export function generatedModule(source: string): string {
  return [
    "// GENERATED by scripts/ae-export-spike/gen-runtime.mts from src/lib/ae-export/runtime/build.jsx.",
    "// Do not edit — edit build.jsx and run `npx tsx scripts/ae-export-spike/gen-runtime.mts`.",
    "",
    "// build.jsx exactly as every After Effects package ships it.",
    `export const BUILD_JSX_SOURCE = ${JSON.stringify(source)};`,
    "",
  ].join("\n");
}

if (process.argv[1] && resolve(process.argv[1]) === resolve(import.meta.filename)) {
  const ts = generatedModule(readFileSync(SRC, "utf8"));
  if (process.argv.includes("--check")) {
    let onDisk = "";
    try {
      onDisk = readFileSync(OUT, "utf8");
    } catch {
      // missing ⇒ stale
    }
    if (onDisk !== ts) {
      console.error("build-jsx.generated.ts is stale — run `npx tsx scripts/ae-export-spike/gen-runtime.mts` and commit.");
      process.exit(1);
    }
    console.log("build-jsx.generated.ts up to date.");
  } else {
    writeFileSync(OUT, ts);
    console.log(`Wrote ${OUT}`);
  }
}
