export const SKSL_5 = "// Generated by toolbox (engine/skia/library/gradient-program.ts): a conical gradient, 2 stops, tile mirror.\n// Interpolates in sRGB, then converts to the canvas's color space (tbx_cm_out),\n// so it draws the same colors on sRGB and Display P3 canvases.\nuniform float tbx_g_x0;\nuniform float tbx_g_y0;\nuniform float tbx_g_r0;\nuniform float tbx_g_x1;\nuniform float tbx_g_y1;\nuniform float tbx_g_r1;\nuniform float4 tbx_g_c0;  // stop 0: straight alpha, sRGB\nuniform float4 tbx_g_c1;  // stop 1: straight alpha, sRGB\nuniform float4 tbx_g_p0;  // stop positions 0..1\n// ---- tbx.color.srgb\nfloat tbx_srgb_to_linear(float c) {\n  return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);\n}\nfloat tbx_linear_to_srgb(float c) {\n  return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055;\n}\nfloat3 tbx_srgb_to_linear3(float3 c) {\n  return float3(tbx_srgb_to_linear(c.r), tbx_srgb_to_linear(c.g), tbx_srgb_to_linear(c.b));\n}\nfloat3 tbx_linear_to_srgb3(float3 c) {\n  return float3(tbx_linear_to_srgb(c.r), tbx_linear_to_srgb(c.g), tbx_linear_to_srgb(c.b));\n}\n// ---- tbx.color.cm\n// sRGB numbers are already working-space numbers (sRGB canvas, or no\n// color space at all): convert nothing. See engine/skia/library/color-management.ts.\n// The intrinsics are always evaluated, never inside a branch, and the result\n// is SELECTED afterwards: Skia's CPU backend mis-runs a color-space intrinsic\n// inside a conditional once a child has been sampled (CanvasKit 0.41.0).\nbool tbx_cm_active() {\n  half3 w = fromLinearSrgb(half3(0.5, 0.0, 0.0));\n  float r = float(w.r);\n  return abs(float(w.g)) + abs(float(w.b)) + min(abs(r - 0.735357), abs(r - 0.5)) > 0.002;\n}\nfloat3 tbx_cm_enc(float3 srgb) {\n  return float3(fromLinearSrgb(half3(tbx_srgb_to_linear3(srgb))));\n}\nfloat3 tbx_cm_dec(float3 working) {\n  return tbx_linear_to_srgb3(float3(toLinearSrgb(half3(working))));\n}\n// Straight sRGB ↔ the working space (rgb only).\nfloat3 tbx_