 tbx_g_c1, tbx_g_seg(t, q0, q1));\n}\nfloat4 tbx_g_average() {\n  float4 s = float4(0.0);\n  {\n    float a = clamp(tbx_g_p0.x, 0.0, 1.0);\n    float b = clamp(tbx_g_p0.y, a, 1.0);\n    s += a * tbx_g_c0;\n    s += (1.0 - b) * tbx_g_c1;\n    s += 0.5 * (b - a) * (tbx_g_c0 + tbx_g_c1);\n  }\n  return s;\n}\nhalf4 main(float2 p) {\n  bool visible = true;\n  float t = 0.0;\n  bool degenerate = false;\n  float2 c0 = float2(tbx_g_x0, tbx_g_y0);\n  float2 cd = float2(tbx_g_x1, tbx_g_y1) - c0;\n  float dr = tbx_g_r1 - tbx_g_r0;\n  float2 pd = p - c0;\n  bool concentric = length(cd) <= 0.000030517578125;\n  degenerate = concentric && abs(dr) <= 0.000030517578125;\n  bool ring = false;  // (the collapsed-ring stand-in is clamp-only)\n  if (ring) {\n    t = length(pd) / tbx_g_r1;\n  } else if (degenerate) {\n    t = 0.0;\n  } else if (concentric && tbx_g_r0 <= 0.000030517578125) {\n    t = length(pd) / tbx_g_r1;\n  } else {\n    float qa = dot(cd, cd) - dr * dr;\n    float qb = dot(pd, cd) + tbx_g_r0 * dr;\n    float qc = dot(pd, pd) - tbx_g_r0 * tbx_g_r0;\n    if (abs(qa) <= 0.000001 * max(dot(cd, cd) + dr * dr, 0.000000000001)) {\n      t = qc / (2.0 * qb);\n      visible = abs(qb) > 0.0 && tbx_g_r0 + t * dr >= 0.0;\n    } else {\n      float disc = qb * qb - qa * qc;\n      float sq = sqrt(max(disc, 0.0));\n      float hi = max((qb + sq) / qa, (qb - sq) / qa);\n      float lo = min((qb + sq) / qa, (qb - sq) / qa);\n      bool hiOk = tbx_g_r0 + hi * dr >= 0.0;\n      t = hiOk ? hi : lo;\n      visible = disc >= 0.0 && (hiOk || tbx_g_r0 + lo * dr >= 0.0);\n    }\n  }\n  t = abs((t - 1.0) - 2.0 * floor((t - 1.0) * 0.5) - 1.0);\n  float4 c = degenerate ? tbx_g_average() : tbx_g_ramp(t);\n  half4 o = tbx_cm_out(c);\n  return visible ? o : half4(0.0);\n}\n";
