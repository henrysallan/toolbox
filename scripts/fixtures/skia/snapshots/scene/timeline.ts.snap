// Generated by toolbox — the animation timeline.
// Do not edit by hand: change the Skia layer and export again.

import { evaluateTrack, ticksAt, type TimelineTrack } from "./toolbox-timeline";

export const NAME = "Scene fixture";

export const TIMELINE = {
  fps: 30,
  ticksPerFrame: 1000,
  durationTicks: 60000,
  durationSec: 2,
} as const;

// Toolbox canvas px — the scene's own coordinate space.
export const CANVAS = { width: 512, height: 512 } as const;

// Fractional toolbox frame at `seconds` (frame-aligned times are exact).
export function frameAt(seconds: number): number {
  "worklet";
  return ticksAt(seconds, TIMELINE.fps, TIMELINE.ticksPerFrame) / TIMELINE.ticksPerFrame;
}

// A sampled value: the producer's value at frames `f` (ascending from 0).
// Interpolating series keep both ends of each run of equal values, stepped
// ones only its start, so both read back exactly at every frame.
export interface Series<T> {
  f: number[];
  v: T[];
}

function seriesIndex(f: number[], frame: number): number {
  "worklet";
  let lo = 0;
  let hi = f.length - 1;
  if (frame >= f[hi]) return hi;
  while (hi - lo > 1) {
    const mid = (lo + hi) >> 1;
    if (f[mid] <= frame) lo = mid;
    else hi = mid;
  }
  return lo;
}

export function seriesStep<T>(s: Series<T>, frame: number): T {
  "worklet";
  return s.v[seriesIndex(s.f, frame)];
}

export function seriesLerp(s: Series<number>, frame: number): number {
  "worklet";
  const i = seriesIndex(s.f, frame);
  const a = s.v[i];
  if (i >= s.f.length - 1 || frame <= s.f[i]) return a;
  const b = s.v[i + 1];
  if (a === b) return a;
  return a + (b - a) * ((frame - s.f[i]) / (s.f[i + 1] - s.f[i]));
}

export function seriesLerpN(s: Series<number[]>, frame: number): number[] {
  "worklet";
  const i = seriesIndex(s.f, frame);
  const a = s.v[i];
  if (i >= s.f.length - 1 || frame <= s.f[i]) return a;
  const b = s.v[i + 1];
  const u = (frame - s.f[i]) / (s.f[i + 1] - s.f[i]);
  return a.map((x, k) => (x === b[k] ? x : x + (b[k] - x) * u));
}

