// root.children.2.children.1.geom.d: derived from scene.steps (animated: scene.steps); sampled 61 frames — 2 distinct-frame paths, stepped (verbs change).
export const PATH_b104: Series<string> = {"f":[0,30],"v":["M170 120 L95 163.301 L95 76.699 Z","M170 120 L145 163.301 L95 163.301 L70 120 L95 76.699 L145 76.699 Z"]};

// Every animated bind at `seconds` on the toolbox timeline, keyed by bind id
// (manifest.json maps ids to IR paths). Animated path geometry is not here:
// the component reads the pre-parsed PATH_* series itself.
export function sampleBinds(seconds: number) {
  "worklet";
  const tick = ticksAt(seconds, TIMELINE.fps, TIMELINE.ticksPerFrame);
  const frame = tick / TIMELINE.ticksPerFrame;
  return {
    b1: seconds, // master clock (seconds)
    b3: evaluateTrack(T_b3, tick) as number[], // keyframes scene.tint (2 keys), oklab
    b9: evaluateTrack(T_b9, tick) as number[], // Color col.color (2 keys, rgb)
    b12: evaluateTrack(T_b12, tick) as number, // keyframes scene.center (3 keys)
    b13: evaluateTrack(T_b13, tick) as number, // keyframes scene.center (3 keys)
    b14: evaluateTrack(T_b14, tick) as number, // keyframes scene.spin (2 keys) × 0.017453292519943295
    b25: evaluateTrack(T_b25, tick) as number, // Animated Value av (2 keys)
    b39: evaluateTrack(T_b39, tick) as number, // keyframes scene.radius (4 keys)
    b84: evaluateTrack(T_b84, tick) as number, // keyframes scene.spin (2 keys)
    b111: seriesLerpN(S_b111, frame), // derived from scene.spin (animated: scene.spin); sampled 61 frames
    b123: seriesStep(S_b123, frame), // static (untagged animation); sampled 61 frames
    b129: evaluateTrack(T_b129, tick) as number, // keyframes scene.size (2 keys)
    b134: seriesLerpN(S_b134, frame), // derived from scene.spin (animated: scene.spin); sampled 61 frames
    b145: seriesLerp(S_b145, frame), // keyframes scene.radius (4 keys); sampled 61 frames
  };
}
