// Generated by toolbox — Reanimated-native animations.
// Do not edit by hand: change the Skia layer and export again.
//
// Native mode (toolbox export option animation: "native"): every animated
// value is its own shared value, driven by withSequence / withDelay /
// withTiming / withSpring, so app code can interrupt it, chain from it or
// hand it to a gesture (cancelAnimation, withSpring to a new target). Easings
// are Reanimated's own where they equal toolbox's and toolbox's formula
// otherwise (manifest.json native.values lists which).
//
// Reanimated starts each withSequence step on the frame its predecessor
// finished, and a withTiming finishes on the first frame at or past its
// duration. On a steady display clock every step still lands on its toolbox
// frame (durations end 1 µs early to absorb float noise); a frame whose
// timestamp arrives early by more than that pushes the rest of that value's
// sequence one frame late, and the lag adds up step by step. Export with
// animation "worklet" for frame-exact playback whatever the clock does.

import { useCallback, useEffect, useMemo } from "react";
import {
  cancelAnimation,
  Easing,
  useSharedValue,
  withDelay,
  withRepeat,
  withSequence,
  withTiming,
  type SharedValue,
} from "react-native-reanimated";
import { scheduleOnUI } from "react-native-worklets";
import { SEGMENTS, type SegmentName } from "./toolbox-clock";
import { easeOf, evaluateTrackRaw, type TimelineTrack } from "./toolbox-timeline";
import { looped } from "./toolbox-native";
import { TIMELINE } from "./timeline";

// The timeline in ms (TIMELINE.durationSec) — looped animations pad to it.
const TIMELINE_MS = 5000;

// Toolbox frames → ms, 1 µs short. Reanimated ends a step on the first
// frame at or past its duration, and the frame that lands ON a key must
// count: without the margin, float noise in (frame time − start time)
// pushes about half the boundaries to the next frame, a lag that adds up
// down a withSequence.
function frames(n: number): number {
  "worklet";
  return (n * 1000) / TIMELINE.fps - 0.001;
}

// The same curves as data: evaluateTrack(TRACKS.<key>, tick) from
// ./toolbox-timeline is the frame-exact (worklet-mode) value.
export const TRACKS: Record<string, TimelineTrack> = {
  // root.paint.shader.program.uniforms.nskn_scale: Animated Value scale (3 keys)
  b4: {"kind":"scalar","keys":[{"tick":0,"value":3,"easing":"easeOutBack"},{"tick":120000,"value":4.2,"easing":"easeInOutCubic"},{"tick":300000,"value":3,"easing":"linear"}]},
  // root.paint.shader.program.uniforms.nskn_offset_x: Animated Value drift (2 keys)
  b8: {"kind":"scalar","keys":[{"tick":0,"value":0,"easing":"linear"},{"tick":300000,"value":1.5,"easing":"linear"}]},
  // root.paint.shader.program.uniforms.nskn_contrast: Animated Value contrast (4 keys)
  b12: {"kind":"scalar","keys":[{"tick":0,"value":0.8,"easing":"easeOutElastic"},{"tick":90000,"value":1.6,"easing":"easeInOutSine"},{"tick":240000,"value":1.2,"easing":"hold"},{"tick":300000,"value":1.2,"easing":"linear"}]},
};

// ---- easings Reanimated has no equal for: toolbox-timeline.ts's own math ----

// easeOutElastic: Easing.elastic(b) is a different curve (1 − cos³(tπ/2)·cos(tbπ)).
const tbxEaseOutElastic = (t: number) => {
  "worklet";
  return easeOf("easeOutElastic", t);
};

// b8: toolbox's linear cut to f0–f120, as the fraction of the move 0 → 0.6000000000000001.
const tbxCut0 = (t: number) => {
  "worklet";
  return ((evaluateTrackRaw(TRACKS.b8, 0 + t * 120000) as number) - 0) / 0.6000000000000001;
};

// b12: toolbox's easeInOutSine cut to f90–f120, as the fraction of the move 1.6 → 1.5618033988749895.
const tbxCut1 = (t: number) => {
  "worklet";
  return ((evaluateTrackRaw(TRACKS.b12, 90000 + t * 30000) as number) - 1.6) / -0.038196601125010554;
};

// b8: toolbox's linear cut to f120–f300, as the fraction of the move 0.6000000000000001 → 1.5.
const tbxCut2 = (t: number) => {
  "worklet";
  return ((evaluateTrackRaw(TRACKS.b8, 120000 + t * 180000) as number) - 0.6000000000000001) / 0.8999999999999999;
};

// b12: toolbox's easeInOutSine cut to f120–f240, as the fraction of the move 1.5618033988749895 → 1.2.
const tbxCut3 = (t: number) => {
  "worklet";
  return ((evaluateTrackRaw(TRACKS.b12, 120000 + t * 120000) as number) - 1.5618033988749895) / -0.3618033988749896;
};

// b4: toolbox's easeInOutCubic cut to f150–f180, as the fraction of the move 4.177777777777778 → 4.022222222222222.
const tbxCut4 = (t: number) => {
  "worklet";
  return ((evaluateTrackRaw(TRACKS.b4, 150000 + t * 30000) as number) - 4.177777777777778) / -0.1555555555555559;
};

// b8: toolbox's linear cut to f150–f180, as the fraction of the move 0.75 → 0.8999999999999999.
const tbxCut5 = (t: number) => {
  "worklet";
  return ((evaluateTrackRaw(TRACKS.b8, 150000 + t * 30000) as number) - 0.75) / 0.1499999999999999;
};

// b12: toolbox's easeInOutSine cut to f150–f180, as the fraction of the move 1.4618033988749894 → 1.3381966011250106.
const tbxCut6 = (t: number) => {
  "worklet";
  return ((evaluateTrackRaw(TRACKS.b12, 150000 + t * 30000) as number) - 1.4618033988749894) / -0.12360679774997885;
};

// ---- one animation per value ----

// root.paint.shader.program.uniforms.nskn_scale: Animated Value scale (3 keys) — starts at 3.
export function b4Animation(loop = false) {
  "worklet";
  return looped(
    withSequence(
      // f0 → f120 easeOutBack (equal to the last ulp)
      withTiming(4.2, { duration: frames(120), easing: Easing.out(Easing.back(1.70158)) }),
      // f120 → f300 easeInOutCubic (equal to the last ulp)
      withTiming(3, { duration: frames(180), easing: Easing.inOut(Easing.cubic) })
    ),
    5000,
    TIMELINE_MS,
    3,
    loop
  );
}

// b4 over one segment (SEGMENTS), from the segment's start.
export function b4SegmentAnimation(segment: SegmentName, loop = false): number {
  "worklet";
  switch (segment) {
    case "intro": // f0–f120
      return looped(
        // f0 → f120 easeOutBack (equal to the last ulp)
        withTiming(4.2, { duration: frames(120), easing: Easing.out(Easing.back(1.70158)) }),
        2000,
        2000,
        3,
        loop
      );
    case "loop": // f120–f300
      return looped(
        // f120 → f300 easeInOutCubic (equal to the last ulp)
        withTiming(3, { duration: frames(180), easing: Easing.inOut(Easing.cubic) }),
        3000,
        3000,
        4.2,
        loop
      );
    case "flash": // f150–f180
      return looped(
        // f120 → f300 easeInOutCubic, cut to f150–f180 (toolbox's curve)
        withTiming(4.022222222222222, { duration: frames(30), easing: tbxCut4 }),
        500,
        500,
        4.177777777777778,
        loop
      );
  }
  return b4Animation(loop);
}

// root.paint.shader.program.uniforms.nskn_offset_x: Animated Value drift (2 keys) — starts at 0.
export function b8Animation(loop = false) {
  "worklet";
  return looped(
    // f0 → f300 linear
    withTiming(1.5, { duration: frames(300), easing: Easing.linear }),
    5000,
    TIMELINE_MS,
    0,
    loop
  );
}

// b8 over one segment (SEGMENTS), from the segment's start.
export function b8SegmentAnimation(segment: SegmentName, loop = false): number {
  "worklet";
  switch (segment) {
    case "intro": // f0–f120
      return looped(
        // f0 → f300 linear, cut to f0–f120 (toolbox's curve)
        withTiming(0.6000000000000001, { duration: frames(120), easing: tbxCut0 }),
        2000,
        2000,
        0,
        loop
      );
    case "loop": // f120–f300
      return looped(
        // f0 → f300 linear, cut to f120–f300 (toolbox's curve)
        withTiming(1.5, { duration: frames(180), easing: tbxCut2 }),
        3000,
        3000,
        0.6000000000000001,
        loop
      );
    case "flash": // f150–f180
      return looped(
        // f0 → f300 linear, cut to f150–f180 (toolbox's curve)
        withTiming(0.8999999999999999, { duration: frames(30), easing: tbxCut5 }),
        500,
        500,
        0.75,
        loop
      );
  }
  return b8Animation(loop);
}

// root.paint.shader.program.uniforms.nskn_contrast: Animated Value contrast (4 keys) — starts at 0.8.
export function b12Animation(loop = false) {
  "worklet";
  return looped(
    withSequence(
      // f0 → f90 easeOutElastic (toolbox's curve)
      withTiming(1.6, { duration: frames(90), easing: tbxEaseOutElastic }),
      // f90 → f240 easeInOutSine (equal to the last ulp)
      withTiming(1.2, { duration: frames(150), easing: Easing.inOut(Easing.sin) }),
      // f240 → f300 hold
      withDelay(frames(60), withTiming(1.2, { duration: 0 }))
    ),
    5000,
    TIMELINE_MS,
    0.8,
    loop
  );
}

// b12 over one segment (SEGMENTS), from the segment's start.
export function b12SegmentAnimation(segment: SegmentName, loop = false): number {
  "worklet";
  switch (segment) {
    case "intro": // f0–f120
      return looped(
        withSequence(
          // f0 → f90 easeOutElastic (toolbox's curve)
          withTiming(1.6, { duration: frames(90), easing: tbxEaseOutElastic }),
          // f90 → f240 easeInOutSine, cut to f90–f120 (toolbox's curve)
          withTiming(1.5618033988749895, { duration: frames(30), easing: tbxCut1 })
        ),
        2000,
        2000,
        0.8,
        loop
      );
    case "loop": // f120–f300
      return looped(
        withSequence(
          // f90 → f240 easeInOutSine, cut to f120–f240 (toolbox's curve)
          withTiming(1.2, { duration: frames(120), easing: tbxCut3 }),
          // f240 → f300 hold
          withDelay(frames(60), withTiming(1.2, { duration: 0 }))
        ),
        3000,
        3000,
        1.5618033988749895,
        loop
      );
    case "flash": // f150–f180
      return looped(
        // f90 → f240 easeInOutSine, cut to f150–f180 (toolbox's curve)
        withTiming(1.3381966011250106, { duration: frames(30), easing: tbxCut6 }),
        500,
        500,
        1.4618033988749894,
        loop
      );
  }
  return b12Animation(loop);
}

// The scene clock in seconds, for what has no track (iTime, sampled values).
export function clockAnimation(loop = false) {
  "worklet";
  const clock = withTiming(5, { duration: frames(300), easing: Easing.linear });
  return loop ? withRepeat(clock, -1) : clock;
}

// The scene clock over one segment (from its start time).
export function clockSegmentAnimation(segment: SegmentName, loop = false): number {
  "worklet";
  switch (segment) {
    case "intro": {
      const clock = withTiming(2, { duration: frames(120), easing: Easing.linear });
      return loop ? withRepeat(clock, -1) : clock;
    }
    case "loop": {
      const clock = withTiming(5, { duration: frames(180), easing: Easing.linear });
      return loop ? withRepeat(clock, -1) : clock;
    }
    case "flash": {
      const clock = withTiming(3, { duration: frames(30), easing: Easing.linear });
      return loop ? withRepeat(clock, -1) : clock;
    }
  }
  return clockAnimation(loop);
}

// ---- segments ----

// Each value at each segment's start (colors: every segment's progress) —
// where playSegment() puts it before the segment plays.
export interface SegmentStart {
  b4: number;
  b8: number;
  b12: number;
  clock: number;
}
export const SEGMENT_STARTS: Record<SegmentName, SegmentStart> = {
  "intro": { b4: 3, b8: 0, b12: 0.8, clock: 0 },
  "loop": { b4: 4.2, b8: 0.6000000000000001, b12: 1.5618033988749895, clock: 2 },
  "flash": { b4: 4.177777777777778, b8: 0.75, b12: 1.4618033988749894, clock: 2.5 },
};

// ---- the hook ----

export interface ToolboxAnimationValues {
  // root.paint.shader.program.uniforms.nskn_scale: Animated Value scale (3 keys)
  b4: SharedValue<number>;
  // root.paint.shader.program.uniforms.nskn_offset_x: Animated Value drift (2 keys)
  b8: SharedValue<number>;
  // root.paint.shader.program.uniforms.nskn_contrast: Animated Value contrast (4 keys)
  b12: SharedValue<number>;
  // The scene clock in seconds (iTime, sampled values).
  clock: SharedValue<number>;
}

export interface PlaySegmentOptions {
  // Repeat the segment until stop() / another play.
  loop?: boolean;
  // "start" (default): every value jumps to its value at the segment's start
  // first — the frames toolbox shows. "current": scalar values animate on
  // from where they are (an interruption); colors still start at the
  // segment's start.
  from?: "start" | "current";
}

export interface ToolboxAnimations {
  values: ToolboxAnimationValues;
  // (Re)start every value from the first frame, all on one UI frame. loop:
  // repeat the timeline (TIMELINE.durationSec) until stop().
  play(opts?: { loop?: boolean }): void;
  // Play one named segment (toolbox-clock.ts SEGMENTS) the same way; false
  // for a name SEGMENTS doesn't have.
  playSegment(segment: SegmentName, opts?: PlaySegmentOptions): boolean;
  // Cancel every animation where it is (each value keeps its state).
  stop(): void;
}

// The shared values the component reads. autoplay (default true) plays
// on mount; pass false to call play() / playSegment() yourself, or drive
// any value directly.
export function useToolboxAnimations(opts: { autoplay?: boolean; loop?: boolean } = {}): ToolboxAnimations {
  const { autoplay = true, loop = false } = opts;
  const b4Value = useSharedValue(3);
  const b8Value = useSharedValue(0);
  const b12Value = useSharedValue(0.8);
  const clockValue = useSharedValue(0);
  const play = useCallback(
    (o: { loop?: boolean } = {}) => {
      const repeat = o.loop ?? loop;
      scheduleOnUI(() => {
        "worklet";
        // Start inside a frame callback: there an animation's start time is
        // the frame's own timestamp, so every step lands on display frames
        // (outside one it is "now", somewhere between two frames).
        requestAnimationFrame(() => {
          b4Value.value = 3;
          b4Value.value = b4Animation(repeat);
          b8Value.value = 0;
          b8Value.value = b8Animation(repeat);
          b12Value.value = 0.8;
          b12Value.value = b12Animation(repeat);
          clockValue.value = 0;
          clockValue.value = clockAnimation(repeat);
        });
      });
    },
    [loop, b4Value, b8Value, b12Value, clockValue]
  );
  const playSegment = useCallback(
    (segment: SegmentName, o: PlaySegmentOptions = {}) => {
      if (!Object.prototype.hasOwnProperty.call(SEGMENTS, segment)) return false;
      const repeat = o.loop ?? false;
      const jump = (o.from ?? "start") === "start";
      scheduleOnUI(() => {
        "worklet";
        const s = SEGMENT_STARTS[segment];
        // Start inside a frame callback: there an animation's start time is
        // the frame's own timestamp, so every step lands on display frames
        // (outside one it is "now", somewhere between two frames).
        requestAnimationFrame(() => {
          if (jump) b4Value.value = s.b4;
          b4Value.value = b4SegmentAnimation(segment, repeat);
          if (jump) b8Value.value = s.b8;
          b8Value.value = b8SegmentAnimation(segment, repeat);
          if (jump) b12Value.value = s.b12;
          b12Value.value = b12SegmentAnimation(segment, repeat);
          clockValue.value = s.clock;
          clockValue.value = clockSegmentAnimation(segment, repeat);
        });
      });
      return true;
    },
    [b4Value, b8Value, b12Value, clockValue]
  );
  const stop = useCallback(() => {
    cancelAnimation(b4Value);
    cancelAnimation(b8Value);
    cancelAnimation(b12Value);
    cancelAnimation(clockValue);
  }, [b4Value, b8Value, b12Value, clockValue]);
  useEffect(() => {
    if (autoplay) play();
    return stop;
  }, [autoplay, play, stop]);
  return useMemo(
    () => ({ values: { b4: b4Value, b8: b8Value, b12: b12Value, clock: clockValue }, play, playSegment, stop }),
    [play, playSegment, stop, b4Value, b8Value, b12Value, clockValue]
  );
}
