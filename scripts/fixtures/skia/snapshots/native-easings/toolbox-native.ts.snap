// Generated by toolbox — native-mode helpers (worklets).
// Do not edit by hand: change the SkSL Shader node and export again.

import { withDelay, withRepeat, withSequence, withTiming } from "react-native-reanimated";
import { cubicBezierEase, easeOf, springEase, type TimelineKey, type TimelineTrack } from "./toolbox-timeline";

// toolbox's eased fraction u → t for the segment that starts at `key` (its
// interpolate(): customBezier plays linear on colors) — a cut color
// segment's progress (animations.ts tbxCut*).
export function segmentEase(key: TimelineKey, u: number): number {
  "worklet";
  if (key.easing === "hold") return 0;
  if (key.easing === "cubicBezier") return cubicBezierEase(key.bezier ?? { x1: 1 / 3, y1: 1 / 3, x2: 2 / 3, y2: 2 / 3 }, u);
  if (key.easing === "spring") return springEase(key.spring, u);
  return easeOf(key.easing, u);
}

// `animation` ends endMs into the timeline. loop: hold until the timeline
// ends (the wait ends 1 µs early, like every step), set `reset` (the value
// at frame 0) and play again. withRepeat restarts on the frame a cycle
// ends, so that frame shows the cycle's last value: `reset` here, the last
// key for a value whose last key sits on the timeline end (no pad) — which
// only shows when its first and last keys differ.
export function looped(animation: number, endMs: number, totalMs: number, reset: number, loop: boolean): number {
  "worklet";
  if (!loop) return animation;
  if (endMs >= totalMs) return withRepeat(animation, -1);
  return withRepeat(withSequence(animation, withDelay(totalMs - endMs - 0.001, withTiming(reset, { duration: 0 }))), -1);
}

// ---- copied verbatim from toolbox-timeline.ts: toolbox's color math ----

function srgbToLinear(c: number): number {
  "worklet";
  return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
}

function linearToSrgb(c: number): number {
  "worklet";
  return c <= 0.0031308 ? c * 12.92 : 1.055 * Math.pow(c, 1 / 2.4) - 0.055;
}

function rgbToOklab(r0: number, g0: number, b0: number): number[] {
  "worklet";
  const r = srgbToLinear(r0);
  const g = srgbToLinear(g0);
  const b = srgbToLinear(b0);
  const l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
  const m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
  const s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
  const l_ = Math.cbrt(l);
  const m_ = Math.cbrt(m);
  const s_ = Math.cbrt(s);
  return [
    0.2104542553 * l_ + 0.793617785 * m_ - 0.0040720468 * s_,
    1.9779984951 * l_ - 2.428592205 * m_ + 0.4505937099 * s_,
    0.0259040371 * l_ + 0.7827717662 * m_ - 0.808675766 * s_,
  ];
}

function oklabToRgb(L: number, a: number, b: number): number[] {
  "worklet";
  const l_ = L + 0.3963377774 * a + 0.2158037573 * b;
  const m_ = L - 0.1055613458 * a - 0.0638541728 * b;
  const s_ = L - 0.0894841775 * a - 1.291485548 * b;
  const l = l_ * l_ * l_;
  const m = m_ * m_ * m_;
  const s = s_ * s_ * s_;
  return [
    linearToSrgb(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),
    linearToSrgb(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),
    linearToSrgb(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s),
  ];
}

function lerpColor(a: number[], b: number[], t: number, space: "oklab" | "rgb"): number[] {
  "worklet";
  if (space === "rgb") {
    return [
      a[0] + (b[0] - a[0]) * t,
      a[1] + (b[1] - a[1]) * t,
      a[2] + (b[2] - a[2]) * t,
      a[3] + (b[3] - a[3]) * t,
    ];
  }
  const A = rgbToOklab(a[0], a[1], a[2]);
  const B = rgbToOklab(b[0], b[1], b[2]);
  const rgb = oklabToRgb(
    A[0] + (B[0] - A[0]) * t,
    A[1] + (B[1] - A[1]) * t,
    A[2] + (B[2] - A[2]) * t
  );
  return [rgb[0], rgb[1], rgb[2], a[3] + (b[3] - a[3]) * t];
}

// A color track's value from its per-segment progresses (each 0..1, eased
// by Reanimated): the first segment that hasn't finished mixes its two keys
// at its progress — the keys themselves at 0 and 1, as toolbox's exact hits
// — then snaps to 8 bits exactly as evaluateTrack does.
export function colorAt(track: TimelineTrack, p: number[]): number[] {
  "worklet";
  const ks = track.keys;
  let k = 0;
  while (k < p.length - 1 && p[k] === 1) k++;
  const t = p[k];
  const a = ks[k].value as number[];
  const b = ks[k + 1].value as number[];
  const c = t === 0 ? a : t === 1 ? b : lerpColor(a, b, t, track.colorSpace ?? "oklab");
  if (!track.quantize8) return c;
  const q = (x: number) => {
    "worklet";
    return Math.max(0, Math.min(255, Math.round(x * 255))) / 255;
  };
  return [q(c[0]), q(c[1]), q(c[2]), track.quantizeAlpha ? q(c[3]) : (track.alpha ?? 1)];
}

// colorAt before its 8-bit snap.
function colorMix(track: TimelineTrack, p: number[]): number[] {
  "worklet";
  const ks = track.keys;
  let k = 0;
  while (k < p.length - 1 && p[k] === 1) k++;
  const t = p[k];
  const a = ks[k].value as number[];
  const b = ks[k + 1].value as number[];
  return t === 0 ? a : t === 1 ? b : lerpColor(a, b, t, track.colorSpace ?? "oklab");
}

// colorAt's 8-bit snap.
function colorSnap(track: TimelineTrack, c: number[]): number[] {
  "worklet";
  if (!track.quantize8) return c;
  const q = (x: number) => {
    "worklet";
    return Math.max(0, Math.min(255, Math.round(x * 255))) / 255;
  };
  return [q(c[0]), q(c[1]), q(c[2]), track.quantizeAlpha ? q(c[3]) : (track.alpha ?? 1)];
}

// A color in its track's mixing space (lerpColor's: OKLab or gamma RGB),
// alpha last — and back.
function colorToMix(c: number[], space: "oklab" | "rgb"): number[] {
  "worklet";
  if (space === "rgb") return [c[0], c[1], c[2], c[3]];
  const lab = rgbToOklab(c[0], c[1], c[2]);
  return [lab[0], lab[1], lab[2], c[3]];
}
function colorFromMix(m: number[], space: "oklab" | "rgb"): number[] {
  "worklet";
  if (space === "rgb") return m;
  const rgb = oklabToRgb(m[0], m[1], m[2]);
  return [rgb[0], rgb[1], rgb[2], m[3]];
}

// playSegment(…, { from: "current" }): how far `from` (the color on screen)
// sits from the color the progresses `p` give (the segment's start), in the
// track's mixing space.
export function colorOffset(track: TimelineTrack, from: number[], p: number[]): number[] {
  "worklet";
  const space = track.colorSpace ?? "oklab";
  const a = colorToMix(from, space);
  const b = colorToMix(colorMix(track, p), space);
  return [a[0] - b[0], a[1] - b[1], a[2] - b[2], a[3] - b[3]];
}

// colorAt with `offset` mixed back in at weight `w`: w runs 1 → 0 over the
// segment's first move, so the color leaves where it was along that move's
// own curve; at w = 0 it is colorAt exactly.
export function colorFrom(track: TimelineTrack, p: number[], offset: number[], w: number): number[] {
  "worklet";
  if (w === 0) return colorAt(track, p);
  const space = track.colorSpace ?? "oklab";
  const m = colorToMix(colorMix(track, p), space);
  return colorSnap(track, colorFromMix([m[0] + offset[0] * w, m[1] + offset[1] * w, m[2] + offset[2] * w, m[3] + offset[3] * w], space));
}
