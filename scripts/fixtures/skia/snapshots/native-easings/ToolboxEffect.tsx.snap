    e_out_quad: A.e_out_quad.value, // channel keyframes (5 keys)
    e_inout_quad: A.e_inout_quad.value, // channel keyframes (5 keys)
    e_in_cubic: A.e_in_cubic.value, // channel keyframes (5 keys)
    e_out_cubic: A.e_out_cubic.value, // channel keyframes (5 keys)
    e_inout_cubic: A.e_inout_cubic.value, // channel keyframes (5 keys)
    e_in_expo: A.e_in_expo.value, // channel keyframes (5 keys)
    e_out_expo: A.e_out_expo.value, // channel keyframes (5 keys)
    e_in_back: A.e_in_back.value, // channel keyframes (5 keys)
    e_out_back: A.e_out_back.value, // channel keyframes (5 keys)
    e_out_bounce: A.e_out_bounce.value, // channel keyframes (5 keys)
    e_out_elastic: A.e_out_elastic.value, // channel keyframes (5 keys)
    e_ease_in: A.e_ease_in.value, // channel keyframes (5 keys)
    e_ease_out: A.e_ease_out.value, // channel keyframes (5 keys)
    e_ease_inout: A.e_ease_inout.value, // channel keyframes (5 keys)
    e_hold: A.e_hold.value, // channel keyframes (5 keys)
    e_custom: A.e_custom.value, // channel keyframes (5 keys)
