// Do not edit by hand: change the SkSL Shader node and export again.

import React from "react";
import { Canvas, Fill, Shader, Skia, type CanvasRef } from "react-native-skia";
import { useDerivedValue } from "react-native-reanimated";
import type { ToolboxAnimations } from "./animations";
import { SKSL } from "./effect";

const effect = Skia.RuntimeEffect.Make(SKSL);
if (!effect) throw new Error("toolbox export: the SkSL program did not compile on this Skia build");

export interface ToolboxEffectProps {
  // useToolboxAnimations() — the uniforms read its shared values.
  animations: ToolboxAnimations;
