    iResolution: [width, height, 1],
    iTime: 0, // the program never reads iTime
    e_linear: A.e_linear.value, // channel keyframes (5 keys)
    e_in_sine: A.e_in_sine.value, // channel keyframes (5 keys)
    e_out_sine: A.e_out_sine.value, // channel keyframes (5 keys)
    e_inout_sine: A.e_inout_sine.value, // channel keyframes (5 keys)
