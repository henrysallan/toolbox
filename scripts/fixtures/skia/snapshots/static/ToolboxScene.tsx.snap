// Generated by toolbox — the React Native Skia scene.
// Do not edit by hand: change the Skia layer and export again.

import React from "react";
import {
  Canvas,
  Circle,
  Fill,
  Group,
  Path,
  Skia,
  type CanvasRef,
} from "react-native-skia";
import { type SharedValue } from "react-native-reanimated";
import { CANVAS } from "./timeline";

function parsePath(d: string) {
  const path = Skia.Path.MakeFromSVGString(d);
  if (!path) throw new Error(`toolbox export: bad path data "${d.slice(0, 40)}"`);
  return path;
}

const K0 = parsePath("M150 20 L230 64 L150 108 Z");

export interface ToolboxSceneGroupProps {
  // Seconds on the toolbox timeline (see useToolboxClock).
  time: SharedValue<number>;
  // The size to draw at, in points; the scene is authored at CANVAS px.
  width: number;
  height: number;
}

export interface ToolboxSceneProps extends ToolboxSceneGroupProps {
  canvasRef?: React.Ref<CanvasRef>;
}

// The scene as one Group, scaled from toolbox canvas px to width × height:
// drop it into your own <Canvas> to stack it with other content.
export function ToolboxSceneGroup({ width, height }: ToolboxSceneGroupProps) {
  return (
    <Group transform={[{ scaleX: width / CANVAS.width }, { scaleY: height / CANVAS.height }]}>
      <Fill color={[0.02, 0.02, 0.05, 1]} />
      <Group>
        <Circle cx={64} cy={64} r={40} color={[1, 0.4, 0.2, 1]} />
        <Path path={K0} style="stroke" color={[0.3, 0.7, 1, 1]} strokeWidth={4} strokeJoin="round" />
      </Group>
    </Group>
  );
}

export function ToolboxScene({ time, width, height, canvasRef }: ToolboxSceneProps) {
  return (
    <Canvas ref={canvasRef} style={{ width, height }}>
      <ToolboxSceneGroup time={time} width={width} height={height} />
    </Canvas>
  );
}

// The master clock and its controls (play, pause, seek, playSegment, …).
export {
  useToolboxClock,
  SEGMENTS,
  MARKERS,
  type ToolboxClock,
  type ToolboxClockOptions,
  type SegmentName,
} from "./toolbox-clock";
