// Generated by toolbox — the animation timeline.
// Do not edit by hand: change the Skia layer and export again.

import { ticksAt } from "./toolbox-timeline";

export const NAME = "Static fixture";

export const TIMELINE = {
  fps: 30,
  ticksPerFrame: 1000,
  durationTicks: 60000,
  durationSec: 2,
} as const;

// Toolbox canvas px — the scene's own coordinate space.
export const CANVAS = { width: 256, height: 128 } as const;

// Fractional toolbox frame at `seconds` (frame-aligned times are exact).
export function frameAt(seconds: number): number {
  "worklet";
  return ticksAt(seconds, TIMELINE.fps, TIMELINE.ticksPerFrame) / TIMELINE.ticksPerFrame;
}

// Every animated bind at `seconds` on the toolbox timeline, keyed by bind id
// (manifest.json maps ids to IR paths). Animated path geometry is not here:
// the component reads the pre-parsed PATH_* series itself.
export function sampleBinds(seconds: number) {
  "worklet";
  return {};
}
