// Shared by scripts/gen-ae-docs.mts (writes) and check-docs.mts (freshness):
// bundles src/lib/ae-export/docs/**/*.md into src/lib/ae-export/docs/generated.ts.
//
// Slugs: a top-level `ae-conventions.md` → "ae-conventions"; `nodes/<type>.md`
// → "ae-nodes/<type>" (spec §7.5's naming). Frontmatter (`--- key: value ---`)
// is optional; `title` falls back to the first `# ` heading, then the slug.

import { readdirSync, readFileSync, statSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
export const AE_DOCS_DIR = join(ROOT, "src/lib/ae-export/docs");
export const AE_DOCS_OUT = join(AE_DOCS_DIR, "generated.ts");

function walk(dir: string): string[] {
  const out: string[] = [];
  for (const name of readdirSync(dir).sort()) {
    const p = join(dir, name);
    if (statSync(p).isDirectory()) out.push(...walk(p));
    else if (name.endsWith(".md")) out.push(p);
  }
  return out;
}

function parseFrontmatter(src: string): { meta: Record<string, string>; body: string } {
  const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(src);
  if (!m) return { meta: {}, body: src };
  const meta: Record<string, string> = {};
  for (const line of m[1].split(/\r?\n/)) {
    const kv = /^([A-Za-z_][\w-]*):\s*(.*)$/.exec(line);
    if (kv) meta[kv[1]] = kv[2].trim().replace(/^"(.*)"$/, "$1");
  }
  return { meta, body: src.slice(m[0].length) };
}

export interface AeDocEntry {
  slug: string;
  title: string;
  type?: string;
  class?: string;
  // A family page's other node types (frontmatter `aliases: a, b`): they
  // resolve to this page in getAeDocs({ types }).
  aliases?: string[];
  body: string;
}

export function readAeDocs(): AeDocEntry[] {
  const entries: AeDocEntry[] = [];
  for (const file of walk(AE_DOCS_DIR)) {
    const rel = relative(AE_DOCS_DIR, file).replace(/\\/g, "/").replace(/\.md$/, "");
    const slug = rel.startsWith("nodes/") ? `ae-nodes/${rel.slice("nodes/".length)}` : rel;
    const { meta, body } = parseFrontmatter(readFileSync(file, "utf8"));
    let text = body.trim();
    let title = meta.title;
    if (!title) {
      const h = /^#\s+(.+)$/m.exec(text);
      title = h ? h[1].trim() : slug;
      // A leading `# Title` duplicates the header getAeDocs prints.
      if (h && text.startsWith(h[0])) text = text.slice(h[0].length).trim();
    }
    const type = meta.type ?? (slug.startsWith("ae-nodes/") ? slug.slice("ae-nodes/".length) : undefined);
    const aliases = meta.aliases ? meta.aliases.split(",").map((x) => x.trim()).filter(Boolean) : [];
    entries.push({ slug, title, ...(type ? { type } : {}), ...(meta.class ? { class: meta.class } : {}), ...(aliases.length ? { aliases } : {}), body: `${text}\n` });
  }
  return entries;
}

export function renderAeDocsModule(entries = readAeDocs()): string {
  const rows = entries.map((e) => `  ${JSON.stringify(e.slug)}: ${JSON.stringify({ title: e.title, type: e.type, class: e.class, aliases: e.aliases, body: e.body })},`);
  return [
    "// GENERATED by scripts/gen-ae-docs.mts from src/lib/ae-export/docs/**/*.md.",
    "// Do not edit — edit the markdown and run `npx tsx scripts/gen-ae-docs.mts`.",
    "",
    "export interface AeDoc {",
    "  title: string;",
    "  type?: string;",
    "  class?: string;",
    "  aliases?: string[];",
    "  body: string;",
    "}",
    "",
    "export const AE_DOCS: Record<string, AeDoc> = {",
    ...rows,
    "};",
    "",
  ].join("\n");
}
